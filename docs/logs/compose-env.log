$ docker compose -f docker-compose.yml exec -T web printenv WEB_PORT
8080

$ docker compose -f docker-compose.yml exec -T web cat /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}

$ docker compose -f docker-compose.yml exec -T toolbox curl -sS -i http://web:8080
